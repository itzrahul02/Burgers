# Environment Variables
JWT_ACCESS_SECRET=your-access-token-secret-key-must-be-at-least-256-bits-long
JWT_REFRESH_SECRET=your-refresh-token-secret-key-must-be-at-least-256-bits-long

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Razorpay
RAZORPAY_API_KEY=your-razorpay-key
RAZORPAY_API_SECRET=your-razorpay-secret

# Mail
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# MongoDB (only needed for local dev without Docker)
MONGO_URI=mongodb://localhost:27017/burgers

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=